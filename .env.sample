# Database
DATABASE_URL="postgresql://username:password@localhost:5432/nextjs_premium_app?schema=public"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Email Service (Resend)
RESEND_API_KEY="re_xxxxxxxxx"
RESEND_FROM_EMAIL="noreply@yourdomain.com"

# Email Service (SendGrid - Alternative)
SENDGRID_API_KEY="SG.xxxxxxxxx"
SENDGRID_FROM_EMAIL="noreply@yourdomain.com"

# SMS Service (Twilio)
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+1234567890"

# Payment Gateway (Mock/Test)
PAYMENT_GATEWAY_URL="https://api.paymentgateway.com"
PAYMENT_GATEWAY_SECRET="your-payment-gateway-secret"
PAYMENT_WEBHOOK_SECRET="your-webhook-secret"

# UPI Configuration
UPI_MERCHANT_ID="your-merchant-id"
UPI_MERCHANT_NAME="Your Company Name"

# App Configuration
APP_NAME="Premium App"
APP_URL="http://localhost:3000"
ADMIN_EMAIL="admin@yourdomain.com"

# Logging
LOG_LEVEL="info"
LOG_FILE="./logs/app.log"

# Feature Flags
ENABLE_ANALYTICS="true"
ENABLE_EMAIL_NOTIFICATIONS="true"
ENABLE_SMS_NOTIFICATIONS="false"

# Rate Limiting
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX_REQUESTS="100"

# Development
NODE_ENV="development"